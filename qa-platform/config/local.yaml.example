# Copy to config/local.yaml and edit for your workstation (local.yaml is
# gitignored). Loaded by backend/config.py after .env; real environment
# variables still win over these values.
env:
  # Odoo 17 BASELINE target — always a dedicated QA clone, never the
  # production copy. The workbook's expectations were captured here.
  ODOO17_URL: http://localhost:8017
  ODOO17_DB: <your v17 QA clone, e.g. dto_qa17>

  # Read-only PostgreSQL access for the DATA_RECONCILIATION tests.
  # Omit to have those tests report BLOCKED instead of running.
  ODOO17_PG_HOST: localhost
  ODOO17_PG_PORT: 5433
  ODOO17_PG_USER: <db user>
  ODOO17_PG_PASSWORD: <db password>

  # Odoo 19 target, once a local instance exists.
  ODOO19_URL: http://localhost:8019
  ODOO19_DB: <your v19 QA database>
  ODOO19_PG_HOST: localhost
  ODOO19_PG_PORT: 5433
  ODOO19_PG_USER: <db user>
  ODOO19_PG_PASSWORD: <db password>

  # ---- Static-analysis source trees ------------------------------------
  # framework/source_scan.py greps the custom addons for APIs Odoo 19
  # removed. Each root must contain 3rd-addons/ novobi-addons/
  # project-addons/. docker-compose.yml mounts them read-only.
  #
  # ONE ROOT PER TARGET VERSION. resolve_source_root(version) reads
  # DTO_SOURCE_ROOT_<version> first, so a v19 run greps the v19 tree and a
  # v17 run greps the v17 tree, with no setting to flip between runs.
  # Getting this wrong is silent: the scan succeeds and reports the WRONG
  # tree's findings as the target's breakages (TC007 and TC014 on
  # RUN-7197CCBB).
  DTO_SOURCE_ROOT_17: /src/dto17
  DTO_SOURCE_ROOT_19: /src/dto19
  # Legacy single-root fallback, used only when no per-version root matches.
  DTO_SOURCE_ROOT: /src/dto17

  # false opens a real Chromium window for UI tests
  HEADLESS: "true"
